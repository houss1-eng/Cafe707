# Copie ce fichier en .env et remplis-le.

# Base PostgreSQL
DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/cafe707
# true pour une base en ligne (Render, Neon, Railway…)
DATABASE_SSL=false
PORT=3000

# Adresse publique de l'app (pour les QR codes des tables). Ex. https://commande.707.tn
PUBLIC_URL=

# Mot de passe du compte admin créé par « npm run db:seed » (sinon admin707)
ADMIN_PASSWORD=

# Journée de travail : fuseau et heure de début (les commandes avant 5 h comptent pour la veille)
TZ_NAME=Africa/Tunis
DAY_START_HOUR=5

# Docker (docker compose up -d --build) : mot de passe de la base
POSTGRES_PASSWORD=change-moi
